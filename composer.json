{
    "name": "technically/dependency-resolver",
    "description": "Dependency-resolver utility based on PSR-11 container to be used for auto-wiring.",
    "type": "library",
    "keywords": [
        "php",
        "psr-11",
        "dependency-resolver",
        "auto-wiring"
    ],
    "require": {
        "php": "^8.2",
        "psr/container": "^2.0",
        "technically/null-container": "^2.0",
        "technically/callable-reflection": "^0.5.0"
    },
    "require-dev": {
        "technically/array-container": "^2.0",
        "pestphp/pest": "^2.0 || ^3.0 || ^4.0"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Ivan Voskoboinyk",
            "email": "ivan@voskoboinyk.com"
        }
    ],
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "Technically\\DependencyResolver\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Technically\\DependencyResolver\\Tests\\": "tests"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
